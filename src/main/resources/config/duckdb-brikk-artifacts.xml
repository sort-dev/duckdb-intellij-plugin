<artifacts>
  <!-- The GizmoSQL quack JDBC driver (brikk build) — plain JDBC, no Arrow, ZERO runtime
       dependencies (verified from the 0.3.0 pom: junit + duckdb_jdbc are test-scope only), so
       the artifact is a single Maven item resolved from Central. Add a <version> block per new
       release; the driver entry references this artifact by NAME. -->
  <!-- The native DuckDB JDBC driver, pinned by US: JetBrains' built-in "DuckDB" artifact
       resolves from THEIR registry, which lags Maven Central (observed: their index topped out
       at 1.3.1 while Central had 1.5.5.0). Owning the artifact makes "auto" mean OUR
       proven-latest; bump alongside the engine-refresh flow (dep pin + census tag + this). -->
  <artifact id="duckdb-jdbc-brikk" name="DuckDB JDBC (Brikk)">
    <version version="1.5.5.0">
      <item type="maven" url="org.duckdb:duckdb_jdbc:1.5.5.0"/>
      <item type="license" url="https://raw.githubusercontent.com/duckdb/duckdb/main/LICENSE"/>
    </version>
  </artifact>

  <artifact id="quack-jdbc-brikk" name="Quack JDBC (Brikk)">
    <version version="0.5.0">
      <item type="maven" url="dev.brikk.duckdb:quack-jdbc:0.5.0"/>
      <item type="license" url="https://www.apache.org/licenses/LICENSE-2.0.txt"/>
    </version>
    <version version="0.4.0">
      <item type="maven" url="dev.brikk.duckdb:quack-jdbc:0.4.0"/>
      <item type="license" url="https://www.apache.org/licenses/LICENSE-2.0.txt"/>
    </version>
    <version version="0.3.0">
      <item type="maven" url="dev.brikk.duckdb:quack-jdbc:0.3.0"/>
      <item type="license" url="https://www.apache.org/licenses/LICENSE-2.0.txt"/>
    </version>
  </artifact>
</artifacts>
