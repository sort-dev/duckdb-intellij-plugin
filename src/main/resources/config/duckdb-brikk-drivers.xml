<drivers>
  <!-- Local/embedded DuckDB under the DuckDB (Brikk) dialect. Reuses DataGrip's built-in
       downloadable DuckDB artifact BY NAME (DataGrip matches artifacts by name, not id;
       rolling = latest published driver, which also serves the in-process metadata/validator
       queries version-matched to what the user actually runs). -->
  <driver id="duckdb-brikk-native" name="DuckDB (Brikk) — Local" dialect="DuckDBBrikk"
          forced-dbms="DUCKDB_BRIKK" driver-class="org.duckdb.DuckDBDriver">
    <url-template name="default" template="jdbc:duckdb:{file::identifier.db}"/>
    <url-template name="In-memory" template="jdbc:duckdb:"/>
    <artifact name="DuckDB" use="true" rolling="true"/>
    <option name="auto-sync" value="true"/>
  </driver>

  <!-- Remote DuckDB via GizmoSQL using the quack-jdbc driver (NOT Arrow/ADBC based — it decodes
       the serialized results directly, so no add-opens / Arrow memory flags are needed).
       Driver class + jdbc:quack:// scheme are FACTS extracted from
       dev.brikk.duckdb:quack-jdbc:0.3.0-brikk-SNAPSHOT by QuackDriverFactsTest (the brikk build
       keeps upstream's com.gizmodata package — relabel if/when the fork becomes permanent).
       No <artifact> yet: snapshots aren't a driver-download source, so the jar is attached
       manually in the driver settings until a release lands (then: downloadable artifact or
       bundle — see IDEAS.md). -->
  <driver id="duckdb-brikk-quack" name="DuckDB (Brikk) — GizmoSQL (quack)" dialect="DuckDBBrikk"
          forced-dbms="DUCKDB_BRIKK" driver-class="com.gizmodata.quack.jdbc.sql.QuackDriver">
    <url-template name="default"
      template="jdbc:quack://{host::localhost}[:{port::31337}][/{database:path}?][\?&lt;&amp;,user={user:param},password={password:param},useEncryption={useEncryption:param:true},{:identifier}={:param}&gt;]"/>
    <option name="auto-sync" value="true"/>
  </driver>
</drivers>
