<drivers>
  <!-- Local/embedded DuckDB under the DuckDB (Brikk) dialect. Uses OUR pinned
       "DuckDB JDBC (Brikk)" artifact (config/duckdb-brikk-artifacts.xml) rather than DataGrip's
       built-in "DuckDB" artifact: the built-in resolves from JetBrains' registry, which lags
       Maven Central badly (their 1.3.1 vs Central's 1.5.5.0) — with our artifact, driver
       auto-download always matches the engine version this plugin is built and graded against. -->
  <!-- forced-dbms supplies the official DuckDB icon, including its dark variant. -->
  <!-- Name "DuckDB Embedded (sort.dev)": distinct from DataGrip's stock generic "DuckDB" driver,
       matches the dialect label, and the new-data-source default name reads clearly. -->
  <driver id="duckdb-brikk-native" name="DuckDB Embedded (sort.dev)" dialect="DuckDBSQL"
          forced-dbms="DUCKDB_BRIKK" driver-class="org.duckdb.DuckDBDriver">
    <url-template name="default" template="jdbc:duckdb:{file::identifier.db}"/>
    <url-template name="In-memory" template="jdbc:duckdb:"/>
    <artifact name="DuckDB JDBC (Brikk)" use="true" rolling="true"/>
    <option name="auto-sync" value="true"/>
  </driver>

  <!-- Remote DuckDB via GizmoSQL using Sortdev's fork of the original GizmoSQL quack-jdbc
       driver. The fork adds Quack protocol v3 support for DuckDB 2.0; the original does not.
       It is NOT Arrow/ADBC based — it decodes the serialized results directly, so no add-opens
       / Arrow memory flags are needed.
       Driver class + jdbc:quack:// scheme are FACTS extracted from
       dev.brikk.duckdb:quack-jdbc:0.8.0 by QuackDriverFactsTest. The fork keeps the
       original com.gizmodata package for compatibility.
       Downloadable via the "Quack JDBC (Brikk)" artifact (config/duckdb-brikk-artifacts.xml,
       resolved from Maven Central) — no manual jar attach needed. -->
  <driver id="duckdb-brikk-quack" name="DuckDB via Quack (sort.dev)" dialect="DuckDBSQL"
          forced-dbms="DUCKDB_BRIKK" driver-class="com.gizmodata.quack.jdbc.sql.QuackDriver">
    <!-- Auth is a TOKEN and the driver needs it as a `token` URL parameter at test/connect time
         (connections are not stateless). The param VALUE is sourced from DataGrip's password
         field ({password:param}) so the secret lives in secure storage, not plain text in the
         URL box. No user concept — the User field must be left BLANK (drivers.xml cannot hide
         or relabel the stock user/password fields; a DatabaseAuthProvider-based "Token" auth
         panel is the post-0.1.0 fix). `tls` defaults false here AND in the driver — the SSH/SSL
         dialog tab is generic IDE UI and not what this driver reads; the tls URL param is the
         real switch. tokenEnv/tokenFile/timeouts can be appended as extra params. -->
    <url-template name="default"
      template="jdbc:quack://{host::localhost}[:{port::9494}][/{database:path}?][\?&lt;&amp;,token={password:param},tls={tls:param:false},{:identifier}={:param}&gt;]"/>
    <artifact name="Quack JDBC (Brikk)" use="true" rolling="true"/>
    <option name="auto-sync" value="true"/>
  </driver>
</drivers>
